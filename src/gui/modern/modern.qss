/*
 * qBitFusion modern appearance.
 *
 * Design language: true-neutral surfaces, hairline dividers, small radii, and one accent colour
 * (palette(highlight), chosen by the user) for selection, progress, focus and "on" states. Hover is a
 * neutral overlay; selection is a light tint of the accent; primary buttons are inverse-neutral. Colours come from the application palette or from
 * the @tokens@ substituted per scheme in modernappearance.cpp, so this one sheet serves light and dark.
 */

* {
    outline: 0;
}

QMainWindow,
QDialog {
    background: palette(window);
}

/* ---------------------------------------------------------------- menus */

QMenuBar {
    background: palette(window);
    padding: 2px 6px;
    border: none;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 5px;
    background: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background: @hoverStrong@;
}

QMenu {
    background: @surfaceRaised@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 28px 6px 10px;
    border-radius: 5px;
    background: transparent;
}

QMenu::item:selected {
    background: @hoverStrong@;
    color: palette(window-text);
}

QMenu::item:disabled {
    color: @muted@;
}

QMenu::separator {
    height: 1px;
    background: @border@;
    margin: 5px 6px;
}

QMenu::icon {
    padding-left: 6px;
}

QMenu::right-arrow {
    image: url(:/qbitfusion/chevron-right.svg);
    width: 12px;
    height: 12px;
    right: 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 6px;
}

QMenu::indicator:checked {
    image: url(:/qbitfusion/check-accent.svg);
}

/* ---------------------------------------------------------------- toolbars */

QToolBar {
    background: palette(window);
    border: none;
    padding: 2px 8px 4px 8px;
    spacing: 2px;
}

QToolBar::separator {
    width: 1px;
    background: @border@;
    margin: 6px 8px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover {
    background: @hoverStrong@;
}

QToolButton:pressed,
QToolButton:checked {
    background: @selectionInactive@;
}

QToolButton::menu-indicator {
    image: none;
}

QToolButton[popupMode="1"] {
    padding-right: 18px;
}

QToolButton::menu-button {
    border: none;
    background: transparent;
    width: 14px;
}

QToolButton::menu-arrow {
    image: url(:/qbitfusion/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* Header: brand, pages, search, primary action */
QToolBar[qbfHeader="true"] {
    padding: 7px 10px 7px 8px;
    spacing: 3px;
    border-bottom: 1px solid @border@;
}

QToolBar[qbfHeader="true"] QToolButton {
    padding: 6px;
}

/* Action bar over the torrent list */
QToolBar[qbfActionBar="true"] {
    background: palette(base);
    padding: 5px 8px;
    spacing: 1px;
    border-bottom: 1px solid @border@;
}

QToolBar[qbfActionBar="true"] QToolButton {
    padding: 5px 8px;
    color: palette(window-text);
}

QToolBar[qbfActionBar="true"]::separator {
    margin: 5px 6px;
}

QToolButton#qbfAddButton {
    background: @primaryBg@;
    color: @primaryText@;
    font-weight: 600;
    padding: 6px 12px 6px 9px;
    padding-right: 30px;
}

QToolButton#qbfAddButton:hover {
    background: @primaryHover@;
}

QToolButton#qbfAddButton:pressed {
    background: @primaryPressed@;
}

QToolButton#qbfAddButton::menu-button {
    width: 22px;
    border-left: 1px solid @primaryDivider@;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QToolButton#qbfAddButton::menu-arrow {
    image: url(:/qbitfusion/chevron-down-on-@glyph@.svg);
}

QLabel#qbfSelectionSummary {
    color: @muted@;
    padding: 0 8px;
}

QLabel#qbfEmptyBody {
    color: @muted@;
}

/* ---------------------------------------------------------------- main window surfaces */

QWidget#qbfListPage,
PropertiesWidget {
    background: palette(base);
}

TransferListWidget,
PropertiesWidget QTreeView,
PropertiesWidget QListView,
PropertiesWidget QScrollArea,
PropertiesWidget QTextEdit {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}

PropertiesWidget QScrollArea > QWidget > QWidget {
    background: transparent;
}

TransferListWidget QHeaderView,
TransferListWidget QHeaderView::section,
PropertiesWidget QHeaderView,
PropertiesWidget QHeaderView::section {
    background: transparent;
}

QAbstractItemView[qbfSidebarList="true"] {
    background: transparent;
    border: none;
    padding: 0;
}

QAbstractItemView[qbfSidebarList="true"]::item,
QAbstractItemView[qbfSidebarList="true"]::item:hover,
QAbstractItemView[qbfSidebarList="true"]::item:selected {
    background: transparent;
    margin: 0;
    padding: 0;
}

QTreeView[qbfSidebarList="true"] {
    show-decoration-selected: 0;
}

QTreeView[qbfSidebarList="true"]::branch,
QTreeView[qbfSidebarList="true"]::branch:selected {
    background: transparent;
}

QTabWidget[documentMode="true"]::pane {
    border: none;
    background: transparent;
}

QSplitter::handle {
    background: @border@;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* ---------------------------------------------------------------- item views */

QTreeView,
QListView,
QTableView {
    background: palette(base);
    alternate-background-color: palette(alternate-base);
    border: 1px solid @border@;
    border-radius: 6px;
    selection-background-color: @selection@;
    selection-color: @selectionText@;
    padding: 1px;
}

QTreeView::item,
QListView::item,
QTableView::item {
    padding: 5px 4px;
    border: none;
}

QTreeView::item:hover,
QListView::item:hover {
    background: @hover@;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: @selection@;
    color: @selectionText@;
}

QTreeView {
    show-decoration-selected: 1;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:selected {
    background: @selection@;
}

QTreeView::branch:has-children:closed {
    image: url(:/qbitfusion/chevron-right.svg);
}

QTreeView::branch:has-children:open {
    image: url(:/qbitfusion/chevron-down.svg);
}

/* Page lists (Options): compact rows. */
QListWidget::item {
    border-radius: 5px;
    padding: 4px 6px;
    margin: 1px 2px;
}

QListWidget::item:selected {
    background: @selection@;
    color: @selectionText@;
}

QListWidget#tabSelection {
    background: transparent;
    border: none;
}

QHeaderView {
    background: palette(base);
    border: none;
}

QHeaderView::section {
    background: palette(base);
    color: @muted@;
    padding: 7px 8px;
    border: none;
    border-bottom: 1px solid @border@;
    font-weight: 500;
}

QHeaderView::section:hover {
    color: palette(text);
}

QHeaderView::up-arrow {
    image: url(:/qbitfusion/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QHeaderView::down-arrow {
    image: url(:/qbitfusion/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QTableCornerButton::section {
    background: palette(base);
    border: none;
}

/* ---------------------------------------------------------------- inputs */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    background: palette(base);
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: @borderStrong@;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid palette(highlight);
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: @muted@;
    background: palette(window);
}

QComboBox {
    padding-right: 26px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    image: url(:/qbitfusion/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background: @surfaceRaised@;
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: @hoverStrong@;
    selection-color: palette(window-text);
}

QSpinBox,
QDoubleSpinBox {
    padding-right: 22px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    width: 20px;
    border: none;
    background: transparent;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/qbitfusion/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/qbitfusion/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* ---------------------------------------------------------------- buttons */

QPushButton {
    background: palette(button);
    color: palette(button-text);
    border: 1px solid @border@;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 18px;
}

QPushButton:hover {
    border-color: @borderStrong@;
}

QPushButton:pressed,
QPushButton:checked {
    background: @selectionInactive@;
}

QPushButton:default,
QPushButton#qbfPrimaryButton {
    background: @primaryBg@;
    color: @primaryText@;
    border: 1px solid @primaryBg@;
    font-weight: 600;
}

QPushButton:default:hover,
QPushButton#qbfPrimaryButton:hover {
    background: @primaryHover@;
    border: 1px solid @primaryHover@;
}

QPushButton:default:pressed,
QPushButton#qbfPrimaryButton:pressed {
    background: @primaryPressed@;
    border: 1px solid @primaryPressed@;
}

QPushButton:disabled {
    color: @muted@;
    border-color: @border@;
    background: palette(window);
}

QPushButton:flat {
    background: transparent;
    border: none;
    color: palette(link);
}

QPushButton:flat:hover {
    text-decoration: underline;
}

QPushButton::menu-indicator {
    image: url(:/qbitfusion/chevron-down.svg);
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 6px;
}

/* Details panel tabs: plain text tabs; the current one gets a neutral fill. */
QPushButton[qbfPropTab="true"] {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    color: @muted@;
    font-weight: 400;
}

QPushButton[qbfPropTab="true"]:hover {
    background: @hover@;
    color: palette(window-text);
}

QPushButton[qbfPropTab="true"]:pressed,
QPushButton[qbfPropTab="true"][qbfCurrent="true"] {
    background: @selection@;
    color: palette(window-text);
    font-weight: 600;
}

/* ---------------------------------------------------------------- check & radio */

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QTreeView::indicator,
QListView::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid @borderStrong@;
    border-radius: 4px;
    background: palette(base);
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover {
    border-color: palette(highlight);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QTreeView::indicator:checked,
QListView::indicator:checked {
    background: palette(highlight);
    border-color: palette(highlight);
    image: url(:/qbitfusion/check.svg);
}

QCheckBox::indicator:indeterminate,
QTreeView::indicator:indeterminate {
    background: palette(highlight);
    border-color: palette(highlight);
    image: url(:/qbitfusion/dash.svg);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled {
    border-color: @border@;
    background: palette(window);
}

QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid @borderStrong@;
    border-radius: 8px;
    background: palette(base);
}

QRadioButton::indicator:hover {
    border-color: palette(highlight);
}

QRadioButton::indicator:checked {
    background: palette(highlight);
    border-color: palette(highlight);
    image: url(:/qbitfusion/dot.svg);
}

/* ---------------------------------------------------------------- containers */

QGroupBox {
    background: transparent;
    border: 1px solid @border@;
    border-radius: 8px;
    margin-top: 22px;
    padding: 4px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    padding: 0 4px 4px 4px;
    color: palette(window-text);
    font-weight: 600;
}

/* Details panel: its groups are plain sections, not boxes. */
PropertiesWidget QGroupBox {
    border: none;
    border-top: 1px solid @border@;
    border-radius: 0;
    margin-top: 24px;
    padding: 6px 4px 4px 4px;
}

PropertiesWidget QGroupBox::title {
    color: @muted@;
    font-weight: 500;
    left: 0;
}

QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: 6px;
    background: palette(base);
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: @muted@;
    padding: 6px 12px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: palette(window-text);
}

QTabBar::tab:selected {
    color: palette(window-text);
    border-bottom: 2px solid palette(highlight);
}

QScrollArea {
    background: transparent;
    border: none;
}

QStatusBar {
    background: palette(window);
    border-top: 1px solid @border@;
    color: @muted@;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: @muted@;
    padding: 0 6px;
}

QStatusBar QPushButton,
QStatusBar QPushButton:flat {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 3px 8px;
    min-height: 16px;
    color: palette(window-text);
    text-decoration: none;
}

QStatusBar QPushButton:hover,
QStatusBar QPushButton:flat:hover {
    background: @hoverStrong@;
    text-decoration: none;
}

QToolTip {
    background: palette(tool-tip-base);
    color: palette(tool-tip-text);
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 5px 7px;
}

QProgressBar {
    background: @border@;
    border: none;
    border-radius: 2px;
    text-align: center;
    min-height: 4px;
    max-height: 4px;
    color: transparent;
}

QProgressBar::chunk {
    background: palette(highlight);
    border-radius: 2px;
}

/* ---------------------------------------------------------------- scrollbars */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: @selectionInactive@;
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    background: @selectionInactive@;
    border-radius: 3px;
    min-width: 32px;
}

QScrollBar::handle:hover {
    background: @borderStrong@;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}
